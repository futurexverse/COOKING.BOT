{
    "name": "cooking",
    "version": "1.0.0",
    "type": "module",
    "description": "Autonomous Solana token launch agent with AI-driven market analysis, deployment, and guardian monitoring",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "start:api": "node dist/server.js",
        "start:bot": "node dist/bot/index.js",
        "dev": "tsx watch src/server.ts",
        "dev:bot": "tsx watch src/bot/index.ts",
        "build": "tsc",
        "postinstall": "npm run build",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@fastify/static": "^10.1.3",
        "@solana/spl-token": "^0.4.9",
        "@solana/web3.js": "^1.98.0",
        "bs58": "^6.0.0",
        "dotenv": "^16.4.7",
        "fastify": "^5.0.0",
        "node-fetch": "^3.3.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^20.17.10",
        "eslint": "^9.16.0",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.17.0",
        "vitest": "^4.0.18"
    }
}
