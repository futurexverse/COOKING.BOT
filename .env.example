PORT=3000

# Optional: Telegram — guardian alerts, launch notifications
# Bot token from @BotFather.
#TELEGRAM_BOT_TOKEN=your_bot_token_here
#TELEGRAM_CHAT_ID=
#TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210

# Trending source: jupiter (default), dexscreener, or pumpfun (requires PUMPFUN_API_URL)
ORACLE_TRENDING_SOURCE=jupiter
# Optional: Pump.fun–compatible API URL for ORACLE_TRENDING_SOURCE=pumpfun
#PUMPFUN_API_URL=
# Jupiter 24h trending (optional API key for higher rate limits)
#JUPITER_API_KEY=your_jupiter_api_key_here
#ORACLE_JUPITER_TRENDING_LIMIT=50

# Dexscreener (only when ORACLE_TRENDING_SOURCE=dexscreener)
DEXSCREENER_QUERY=solana

# Append deterministic heat/setup metrics line to main tweets (set false to hide)
#ORACLE_TWEET_METRICS=true

# Interval between autonomous scan/post cycles (in seconds)
ORACLE_SCAN_INTERVAL_SECONDS=900

# Minimum minutes between main timeline posts (bot skips the post step until this elapses)
ORACLE_MIN_POST_INTERVAL_MINUTES=15

# Market burst bypass: when main post cooldown (ORACLE_MIN_POST_INTERVAL_MINUTES) is active, still fetch trending
# and allow a post if burst rules + burst cooldown pass. Best with ORACLE_TRENDING_SOURCE=jupiter (short-window stats).
#ORACLE_BURST_BYPASS_ENABLED=false
#ORACLE_BURST_MIN_CHANGE_1H=25
#ORACLE_BURST_MIN_CHANGE_1H_DELTA=12
#ORACLE_BURST_MIN_CHANGE_24H=40
#ORACLE_BURST_MIN_CHANGE_24H_DELTA=25
#ORACLE_BURST_TOP_K=10
#ORACLE_BURST_NEW_IN_TOP=3
# Min minutes between burst-bypass posts (separate from main interval)
#ORACLE_BURST_MIN_MINUTES_BETWEEN_POSTS=15
# Optional: leader must be at least this liquid (USD) to count for burst
#ORACLE_BURST_MIN_LIQUIDITY=0
#ORACLE_BURST_FORCE_INTENSITY=true
#ORACLE_BURST_BYPASS_QUIET_REGIME=true

# Persistent data directory for reply_state, bot_state, dedupe_state, oracle_state.
# Set this in Docker to a mounted volume path (e.g. /data) so the bot does not re-reply to old mentions after restarts.
#ORACLE_DATA_DIR=/data
# Symbols to never surface (comma-separated; default includes SNS,UNTAXED)
#ORACLE_BLACKLIST_SYMBOLS=SNS,UNTAXED

# Reply agent: replies only when @mentioned and never to the same tweet twice (state in data/reply_state.json).
# Maximum replies per run (0 disables replies).
#ORACLE_MAX_REPLIES_PER_RUN=3
# One-time reset: set to true or 1 and run start:bot once to clear reply history (then remove this var).
#ORACLE_REPLIES_RESET_STATE=false

# Reserved for future use: toggle contract-analysis replies when a Solana mint
# appears in a mention (currently the bot always replies with contract context when mints are present).
#ORACLE_REPLY_ENABLE_CONTRACT_ANALYSIS=true

# Optional: Helius enrichment (required for hourly top-5 safety screening)
#HELIUS_API_KEY=your_helius_api_key_here
#HELIUS_BASE_URL=https://mainnet.helius-rpc.com

# Hourly top-5 movers: Jupiter pool + Helius DAS (mint/freeze authorities) + optional Jupiter quote
#ORACLE_TOP5_ENABLED=true
#ORACLE_TOP5_INTERVAL_SECONDS=3600
#ORACLE_TOP5_COUNT=5
# Broad candidate pool before screening (20–100)
#ORACLE_TOP5_POOL_SIZE=80
# Sort key for ranking before walk: 1h (default) or 24h
#ORACLE_TOP5_SORT=1h
# Reject if freeze authority still set (default true)
#ORACLE_TOP5_REJECT_FREEZE_AUTHORITY=true
# Optional extra gate: min 1h volume (USDC-style units from Jupiter volumeChange)
#ORACLE_TOP5_MIN_VOLUME_1H=0
# Override holder / liquidity mins for this path (defaults use thresholds.json + ORACLE_* envs)
#ORACLE_TOP5_MIN_HOLDERS=
#ORACLE_TOP5_MIN_LIQUIDITY=
# Best-effort sell-route check (not a honeypot proof)
#ORACLE_TOP5_JUPITER_QUOTE=false
# Solscan links appended to digest (0–5; default 2 to stay under length limits)
#ORACLE_TOP5_LINK_COUNT=2
# Wait for ORACLE_MIN_POST_INTERVAL_MINUTES after any post before top-5 tweet
#ORACLE_TOP5_RESPECT_MAIN_POST_INTERVAL=true

# Learning and server toggles
#LEARNING_ENABLED=true
#ORACLE_DISABLE_SERVER=true
# Optional: debug ingest URL for /api/scan payload logging (only used when set)
#ORACLE_DEBUG_INGEST_URL=
# Optional: rate limit POST /api/scan (requests per minute per IP or x-api-key). 0 = disabled.
#ORACLE_SCAN_RATE_LIMIT_PER_MIN=60

# ─────────────────────────────────────────────────────────────
# ORACLE-AUTHOR: Autonomous Token Launch Agent
# ─────────────────────────────────────────────────────────────

# Solana wallet (base58 encoded private key) — dedicated hot wallet for token launches
# NEVER commit this to git. Fund with only what you're willing to risk.
SOLANA_PRIVATE_KEY=your_base58_private_key_here
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional: dedicated RPC with higher rate limits
#SOLANA_RPC_URL=https://your-quicknode-endpoint.quiknode.pro/xxxxx

# Launch configuration
LAUNCH_PLATFORM=auto
# auto = AI decides between pumpfun/raydium based on conditions
# pumpfun = always use Pump.fun
# raydium = always use Raydium

LAUNCH_MIN_CONFIDENCE=0.75
LAUNCH_MAX_COST_SOL=5.0
LAUNCH_APPROVAL_TIMEOUT_SECONDS=300

# Pump.fun specific
PUMPFUN_API_URL=https://pumpportal.fun/api
PUMPFUN_SLIPPAGE_BPS=500

# Raydium specific (Phase 2)
#RAYDIUM_INITIAL_LIQUIDITY_SOL=5.0
#RAYDIUM_SLIPPAGE_BPS=300

# Guardian monitoring
GUARDIAN_ENABLED=true
GUARDIAN_INTERVAL_SECONDS=60
GUARDIAN_STOP_LOSS_PCT=-30
GUARDIAN_TAKE_PROFIT_PCT=100
GUARDIAN_LIQUIDITY_DROP_ALERT_PCT=50
GUARDIAN_PRICE_ALERT_PCT=20
GUARDIAN_HOLDER_MILESTONES=100,500,1000,5000,10000

# Approval flow
APPROVAL_METHOD=telegram
# telegram = bot DMs you for approval
# api = you call POST /api/approve/:id manually

# Market analysis
MARKET_HEAT_MIN=0.60
MARKET_SCAN_INTERVAL_SECONDS=300
